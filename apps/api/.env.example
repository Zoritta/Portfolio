# Local Postgres (matches docker-compose.yml at the repo root). DIRECT_URL only needs to differ
# from DATABASE_URL against a pooled host like Neon in production — locally there's no pooler, so
# both point at the same place. See prisma/schema.prisma's `directUrl` for why this exists.
DATABASE_URL="postgresql://portfolio:portfolio@127.0.0.1:5432/portfolio?schema=public&sslmode=disable"
DIRECT_URL="postgresql://portfolio:portfolio@127.0.0.1:5432/portfolio?schema=public&sslmode=disable"

# OpenAI API key — used for generating embeddings (Job Fit Analyzer / RAG pipeline).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=
